<% provide :title, t(".page_title") %>
<!-- Banner -->
<div class="position-relative text-white mb-5">
  <%= image_tag Settings.images.banner_image, class: "img-fluid w-100 rounded-5", id: "banner-image", alt: "Banner" %>
  <div class="home-search">
    <h2 class="fw-bold display-2 mb-1"><%= t(".greeting") %></h2>
    <h2 class="fw-bold display-2 mt-1 mb-1"><%= current_user&.name || t(".guest") %></h2>
    <p class="mb-5"><%= t(".start_with_book") %></p>
    <h5 class="mb-2 border border-white rounded-5 p-3 text-center d-inline-block"><%= t(".request_book") %></h5>

    <!-- Search form -->
    <%= form_with url: search_books_path, method: :get, local: true, class: "d-flex mt-3" do |f| %>
      <%= f.select :search_type,
          search_type_options_for_select(params[:search_type] || BooksController::DEFAULT_SEARCH_TYPE),
          {},
          { class: "form-select form-select-lg w-auto rounded-start-5 text-center" } %>

      <%= f.text_field :query,
          value: params[:query],
          placeholder: t(".search_placeholder"),
          class: "home-search-query form-control form-control-lg border-start-0 border-end-0 rounded-0 px-5" %>

      <%= f.submit "🔍", class: "btn btn-danger rounded-end-5 px-4 home-search-btn" %>
    <% end %>
  </div>
</div>

<!-- Section: Books with filter -->
<div class="mb-5 ps-5" id="books-section">
  <%= turbo_frame_tag "books_section" do %>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="fw-semibold"><%= t(".good_morning") %></h4>
        <p class="text-muted mb-3"><%= t(".sub_message") %></p>
      </div>

      <!-- Drop bar filter -->
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle"
                type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <%= current_filter_label(params[:filter]) %>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="filterDropdown">
          <% filter_options.each do |value, label| %>
            <li>
              <%= link_to label,
                          root_path(filter: value),
                          class: "dropdown-item #{params[:filter] == value ? "active" : ""}",
                          data: { turbo_frame: "books_section" } %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <%= render partial: "books/recommended_books",
              locals: { books: @books, pagy: @pagy_books } %>
  <% end %>
</div>
